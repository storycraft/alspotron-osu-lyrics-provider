{
  "name": "alspotron-osu-lyrics-provider",
  "version": "0.1.0",
  "description": "osu-lyrics source provider for Alsptoron",
  "main": "index.js",
  "scripts": {
    "build": "pnpm build:native && pnpm build:node",
    "build:node": "node build.mjs",
    "build:native": "cargo build --release --message-format=json > node_modules\\cargo.log && neon dist -l node_modules\\cargo.log"
  },
  "keywords": [],
