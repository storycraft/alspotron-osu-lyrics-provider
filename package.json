  "license": "MIT",
  "dependencies": {
    "@electron/rebuild": "^4.0.1",
    "@neon-rs/cli": "0.1.82",
    "@types/node": "^22.15.3",
    "alspotron": "github:organization/alspotron",
    "esbuild": "^0.25.3",
    "esbuild-plugin-tsc": "^0.5.0",
    "osu-parsers": "^4.1.7",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.7.1",
  "devDependencies": {
    "dll-inject": "^0.0.3"
  },
  "os": [
    "win32"
  ]
}
